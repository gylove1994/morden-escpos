# Self-hosted production-style env (unprefixed schema keys).
# No Stripe / platform-admin secrets — those surfaces are compile-omitted.

NODE_ENV=production
PORT=43128
BASE_URL=http://127.0.0.1:43128
LOG_LEVEL=info
EDITION=self-hosted
DATABASE_URL=postgres://morden:morden@127.0.0.1:5432/morden_escpos
AUTH_SECRET=replace-with-a-unique-secret-at-least-32-chars
