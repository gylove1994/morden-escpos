# Non-development / deployment env (unprefixed schema keys).

NODE_ENV=production
PORT=43128
BASE_URL=http://127.0.0.1:43128
LOG_LEVEL=info
EDITION=cloud
DATABASE_URL=postgres://morden:morden@127.0.0.1:5432/morden_escpos
# Human session auth (Better Auth). MUST be unique and secret in real deployments.
AUTH_SECRET=replace-with-a-unique-secret-at-least-32-chars

# Stripe (cloud edition). Use test-mode keys until go-live.
# Required when EDITION=cloud; omit / unused when EDITION=self-hosted.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PERSONAL=price_test_personal_replace_me
STRIPE_PRICE_BUSINESS=price_test_business_replace_me
BILLING_RESELLER_CONTACT_URL=mailto:gylove1994@acgsteps.com?subject=morden-escpos%20reseller%20inquiry
# Exclusive job lease duration (ms). Expired leases return to queued.
JOB_LEASE_MS=30000

# Platform tenant-ops (cloud). Bearer secret for /api/platform/* (min 32 chars).
PLATFORM_ADMIN_SECRET=replace-with-a-unique-platform-admin-secret
