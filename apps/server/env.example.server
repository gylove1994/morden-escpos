# Non-development / deployment env (unprefixed schema keys).

NODE_ENV=production
PORT=43128
BASE_URL=http://127.0.0.1:43128
LOG_LEVEL=info
EDITION=cloud
DATABASE_URL=postgres://morden:morden@127.0.0.1:5432/morden_escpos
# Human session auth (Better Auth). MUST be unique and secret in real deployments.
AUTH_SECRET=replace-with-a-unique-secret-at-least-32-chars
# Exclusive job lease duration (ms). Expired leases return to queued.
JOB_LEASE_MS=30000
# MIT template editor origin for console iframe embed (local preview stays there).
TEMPLATE_EDITOR_ORIGIN=http://127.0.0.1:43127
