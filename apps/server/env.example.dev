# Development env (APP_ prefix). Loaded by dotenvx in package scripts.
# Copy to a local override file if you need machine-specific values.

APP_NODE_ENV=development
APP_PORT=43128
APP_BASE_URL=http://127.0.0.1:43128
APP_LOG_LEVEL=info
APP_EDITION=cloud
APP_DATABASE_URL=postgres://morden:morden@127.0.0.1:5432/morden_escpos

# Also expose EDITION for next.config compile stub (not APP_-stripped).
EDITION=cloud
