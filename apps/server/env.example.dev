# Development env (APP_ prefix). Loaded by dotenvx in package scripts.
# Copy to a local override file if you need machine-specific values.

APP_NODE_ENV=development
APP_PORT=43128
APP_BASE_URL=http://127.0.0.1:43128
APP_LOG_LEVEL=info
APP_EDITION=cloud
APP_DATABASE_URL=postgres://morden:morden@127.0.0.1:5432/morden_escpos
# Human session auth (Better Auth). Generate a unique value for real deployments.
APP_AUTH_SECRET=dev-only-auth-secret-change-me-32chars
# Exclusive job lease duration (ms). Expired leases return to queued.
APP_JOB_LEASE_MS=30000
# MIT template editor origin for console iframe embed (local preview stays there).
APP_TEMPLATE_EDITOR_ORIGIN=http://127.0.0.1:43127
# Printer Agent online window (ms) based on last heartbeat/lease/discovery auth.
APP_PRINTER_AGENT_ONLINE_WINDOW_MS=60000

# Platform tenant-ops (cloud). Bearer secret for /api/platform/* (min 32 chars).
APP_PLATFORM_ADMIN_SECRET=dev-only-platform-admin-secret-32chars

# Also expose EDITION for next.config compile/build flag (not APP_-stripped).
EDITION=cloud
