# Non-development / deployment env (unprefixed schema keys).

NODE_ENV=production
LOG_LEVEL=info
SERVER_URL=http://127.0.0.1:43128
DEVICE_TOKEN=replace-with-printer-agent-device-token
# Optional JSON config file (env values override file keys).
# CONFIG_FILE=./config.example.json
POLL_IDLE_INITIAL_MS=1000
POLL_IDLE_MAX_MS=30000
POLL_IDLE_MULTIPLIER=2
POLL_AFTER_WORK_MS=0
