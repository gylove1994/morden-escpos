# Development env (APP_ prefix). Loaded by dotenvx in package scripts.

APP_NODE_ENV=development
APP_LOG_LEVEL=info
APP_SERVER_URL=http://127.0.0.1:43128
# Device token shown once when the Printer Agent is created/rotated in the console.
APP_DEVICE_TOKEN=replace-with-printer-agent-device-token
# Optional JSON config file (env values override file keys).
# APP_CONFIG_FILE=./config.example.json
APP_POLL_IDLE_INITIAL_MS=1000
APP_POLL_IDLE_MAX_MS=30000
APP_POLL_IDLE_MULTIPLIER=2
APP_POLL_AFTER_WORK_MS=0
