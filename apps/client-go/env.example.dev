# Development env (APP_ prefix). Do not load from application code — export
# these in your shell / process manager, or pass via dotenvx at the command layer.

APP_NODE_ENV=development
APP_SERVER_URL=http://127.0.0.1:43128
APP_DEVICE_TOKEN=replace-with-printer-agent-device-token
APP_LOG_LEVEL=info
APP_POLL_INTERVAL_MS=1000
APP_IDLE_BACKOFF_MS=1000
APP_IDLE_BACKOFF_MAX_MS=30000
