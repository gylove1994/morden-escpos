{
  "name": "morden-node-escpos",
  "version": "1.0.1",
  "description": "A modern ESC/POS printer driver for Node.js with TypeScript support",
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/gylove1994/morden-node-escpos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gylove1994/morden-node-escpos.git"
  },
  "bugs": {
    "url": "https://github.com/gylove1994/morden-node-escpos/issues"
  },
  "keywords": [
    "escpos",
    "thermal printer",
    "receipt printer",
    "pos printer",
    "usb printer",
    "barcode",
    "qrcode",
    "printer"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/controller/json-schema.d.ts"
    },
    "./template": {
      "types": "./dist/controller/template-engine.d.ts",
      "import": "./dist/controller/template-engine.js",
      "require": "./dist/controller/template-engine.js"
    },
    "./template-inputs": {
      "types": "./dist/controller/template-inputs.d.ts",
      "import": "./dist/controller/template-inputs.js",
      "require": "./dist/controller/template-inputs.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "tsc && node dist/index.js",
    "prepublishOnly": "pnpm build",
    "lint": "eslint src examples vitest.config.ts",
    "lint:fix": "eslint src examples vitest.config.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/qr-image": "^3.2.9",
    "get-pixels": "^3.3.3",
    "iconv-lite": "^0.7.0",
    "mutable-buffer": "^4.0.2",
    "ndarray": "^1.0.19",
    "qr-image": "^3.2.0",
    "tslib": "^2.8.1",
    "usb": "^2.16.0"
  },
  "devDependencies": {
    "@types/get-pixels": "^3.3.4",
    "@types/ndarray": "^1.0.14"
  }
}
